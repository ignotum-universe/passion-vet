---

<head> </head>
<main class="">
    <Overline eyebrow="about us" />
<section class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center mb-6">
    <!-- Left Column: Heading -->
    <h1 class="dm-sans-font text-[3rem] leading-[1.1] pt-3">
        Dedicated to 
        <span class="cormorant-garamond-font bg-linear-to-r from-[#D81B60] to-[#F06292] bg-clip-text text-transparent italic">
            Compassionate
        </span> 
        Care
    </h1>

    <!-- Right Column: Paragraph -->
    <p class="dm-sans-font text-[1rem] leading-relaxed text-gray-700">
        Established in 2015, Passion Vet Clinic was founded on a simple
        mission: to provide the best possible care for your pets. Our team
        of motivated veterinarians and loving nurses works in a fully
        computerized, modern environment designed for comfort and precision.
    </p>
</section>
    <section class="grid grid-cols-2 lg:grid-cols-3 gap-5 w-full mb-5">

{services.map((service) => (
    /* 1. Added the unique 'key' using the name */
    <div class="group p-4 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 dm-sans-font md:p-8"
    >
      <!-- Icon Container -->
<div class="w-12 h-12 mb-6 flex items-center justify-center rounded-xl bg-[#C5D8F5]/30 group-hover:bg-linear-to-br group-hover:from-[#D81B60] group-hover:to-[#F06292] transition-all duration-500">
  
  <span class="text-[#0047AB] group-hover:text-white transition-colors duration-300">
    <svg 
      viewBox="0 0 24 24" 
      class="w-6 h-6" 
      fill="currentColor"
    >
      <path d={service.icon} />
    </svg>
  </span>
</div>

      <h3 class="dm-sans-font font-bold text-xl mb-2">
        {service.name}
      </h3>
      <p class="text-gray-500 text-sm leading-relaxed">
        {service.desc}
      </p>
    </div>
  ))}
</div>
    </section>
    <div
        class="relative bg-center aspect-4/2 bg-cover w-full h-auto rounded-[20px]"
        style={`background-image: url(${aboutBackground.src});`}
    >
    </div>
</main>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,700;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap");

    main {
        padding: 4rem clamp(1rem, 20vw, 32rem);
        transition: padding 0.2s ease-out;
    }

    .cormorant-garamond-font {
        font-family: "Cormorant Garamond", serif;
        font-optical-sizing: auto;
        font-weight: 700;
        font-style: italic;
    }

    .dm-sans-font {
        font-family: "DM Sans", sans-serif;
        font-optical-sizing: auto;
        font-weight: 400;
        font-style: normal;
    }

    .aboutservices {
        background-color: #c5d8f5;
        font-size: 1rem;
        color: black;
        min-height: 2.5rem;
        border-radius: 20px;
    }

    @media (max-width: 1280px) {
        main {
            padding: 4rem clamp(0px, 7vw, 32rem);
        }
    }

    @media (max-width: 640px) {
        main {
            padding: 4rem clamp(0px, 5vw, 32rem);
        }
    }
</style>
