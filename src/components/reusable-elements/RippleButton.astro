---
// RippleButton.astro
interface Props {
  class?: string;
  href?: string;
  target?: string;
}
const { class: className, href, target } = Astro.props;
---

<a
  class=`ripple-button flex justify-center relative overflow-hidden group w-full md:w-fit bg-[#0047AB] text-white dm-sans-font font-bold py-4 px-8 rounded-xl mt-6 uppercase transition-colors duration-300 ${className}`
  href={href}
  target={target}
>
  <span class="ripple-circle absolute bg-white rounded-full pointer-events-none"></span>

  <span class="relative z-10 button-text">
    <slot />
  </span>
</a>

<script>
  import { gsap } from 'gsap';

  function initRipple() {
    const buttons = document.querySelectorAll('.ripple-button');

    buttons.forEach((button) => {
      const ripple = button.querySelector('.ripple-circle') as HTMLElement;
      const text = button.querySelector('.button-text') as HTMLElement;

      // Give GSAP full ownership of the ripple's transform/opacity from the start
      gsap.set(ripple, {
        scale: 0,
        opacity: 1,
        xPercent: -50,
        yPercent: -50,
        width: 0,
        height: 0,
      });

      function triggerRipple(x: number, y: number) {
        const rect = button.getBoundingClientRect();
        const localX = x - rect.left;
        const localY = y - rect.top;
        const size = Math.max(rect.width, rect.height) * 2.5;

        gsap.killTweensOf(ripple);

        // Set position & size first, then animate scale from 0 → 1
        gsap.set(ripple, {
          width: size,
          height: size,
          left: localX,
          top: localY,
          scale: 0,
          opacity: 1,
        });

        gsap.to(ripple, {
          scale: 1,
          duration: 0.6,
          ease: 'power2.out',
        });

        gsap.to(text, {
          color: '#0047AB',
          duration: 0.4,
        });
      }

      function releaseRipple() {
        gsap.killTweensOf([ripple, text]);

        gsap.to(ripple, {
          opacity: 0,
          duration: 0.4,
          ease: 'power2.in',
          onComplete: () => gsap.set(ripple, { scale: 0, opacity: 1 }),
        });

        gsap.to(text, {
          color: '#ffffff',
          duration: 0.3,
          ease: 'power2.out',
        });
      }

      // Mouse
      button.addEventListener('mouseenter', (e) => {
        triggerRipple((e as MouseEvent).clientX, (e as MouseEvent).clientY);
      });
      button.addEventListener('mouseleave', releaseRipple);

      // Touch
      button.addEventListener('touchstart', (e) => {
        const touch = (e as TouchEvent).touches[0];
        triggerRipple(touch.clientX, touch.clientY);
      }, { passive: true });

      button.addEventListener('touchend', releaseRipple, { passive: true });
      button.addEventListener('touchcancel', releaseRipple, { passive: true });
    });
  }

  initRipple();
  document.addEventListener('astro:after-swap', initRipple);
</script>

<style>
      @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,700;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap");

    .dm-sans-font {
        font-family: "DM Sans", sans-serif;
        font-optical-sizing: auto;
        font-weight: 800;
        font-style: normal;
    }
  .ripple-button {
    isolation: isolate;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
</style>