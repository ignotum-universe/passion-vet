const nurses = [
    {
        name: "Intan",
        credentials:
            "Diploma in Marine Science and Aquaculture, Specialist Diploma in Veterinary Clinical Practice",
        role: "Nurse",
        profile: "src/assets/staff/5.jpeg",
        description: "Intan graduated with a Diploma in Marine Science and Aquaculture and an additional certification in Specialist Diploma in Veterinary Clinical Practice. In terms of work experience, she has completed both internship and a full-time position for 1.5 years and started working with Passion Veterinary Clinic since 2021. In her personal life, she has a cherished 20-year-old cat that she spend quality time with. She also enjoys building up Lego sets, watching Kdramas and animes, and collecting figurines. Furthermore, she prioritizes spending time with her family and exploring various restaurants and cafes.",
    },
    {
        name: "Thet Aye Cham",
        credentials: "Bachelor of Veterinary Science",
        role: "Nurse",
        profile: "src/assets/staff/6.jpeg",
        description: "Cham graduated with a Bachelor of Veterinary Science from Yezin, Nay Pyi Taw in 2015. Since then, she has gained valuable work experience in veterinary clinics in Myanmar before coming to Singapore in August 2022. Alongside her professional pursuits, she takes great interest in volunteering, traveling, and learning foreign languages. During her free time, she indulges in hobbies such as playing badminton, acquiring new languages, hiking, and cycling.",
    },
    {
        name: "Siti Raidah",
        credentials: "Specialist Diploma in Veterinary Clinical Practice",
        role: "Nurse",
        profile: "src/assets/staff/7.jpeg",
        description: "Raidah graduated with a Specialist Diploma in Veterinary Clinical Practice and has been working in the veterinary industry since 2019 after sparking an interest in feline care. Outside of work she spends her free time in bed with her paralysed cat Po.",
    },
