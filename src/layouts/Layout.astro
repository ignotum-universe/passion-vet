---
// ../layouts/Layout.astro
import '../styles/global.css'; // Your Tailwind v4 entry point
import Navbar from '../components/reusable-elements/Navbar.astro';
import Footer from "../components/reusable-elements/Footer.astro"
const { title = "PASSIONVET (Passion Vet Clinic @ Woodlands blk 136 Marsiling Road" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
<body>
  <Navbar></Navbar>
  <div id="smooth-wrapper">
    <div id="smooth-content">
      <div class="grow">
      <slot /> <!-- Your Astro page content goes here -->
      </div>
      <Footer></Footer>
    </div>
  </div>
</body>
</html>

<style>
  html {
    /* Required for normalizeScroll but allow body to grow */
    overscroll-behavior: none; 
  }

  body {
    margin: 0;
    padding: 0;
    /* REMOVE height: 100% - this is likely your main culprit */
    min-height: 100vh; 
    opacity: 0;
  }

@media (min-width: 1024px) {
    #smooth-wrapper {
      overflow: hidden;
      position: fixed;
      inset: 0;
      z-index: 1;
    }
  }

  #smooth-content {
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

  // Initialize smooth scroll effect
const initSmoother = () => {
  let screensize = gsap.matchMedia();
  let smoother: ScrollSmoother | undefined;

  // disable smooth scroll if screen size is below 1024px
  screensize.add("(min-width: 1024px)", () => {
    smoother = ScrollSmoother.create({
      wrapper: "#smooth-wrapper",
      content: "#smooth-content",
      smooth: 0.8,
      effects: true,
      normalizeScroll: false,
    });

    // Handle the initial setup
    setTimeout(() => {
      smoother?.refresh(); // Optional chaining: only runs if smoother exists
      ScrollTrigger.refresh();
      gsap.to("body", { opacity: 1, duration: 0.5 });
    }, 200);

    return () => {
      smoother?.kill();
      smoother = undefined;
      gsap.set("body", { opacity: 1 });
    };
  });

  // Mobile fallback for visibility
  screensize.add("(max-width: 1024px)", () => {
    gsap.to("body", { opacity: 1, duration: 0.5 });
  });

  window.addEventListener("resize", () => {
    if (smoother) {
      smoother.refresh();
    }
    ScrollTrigger.refresh();
  });
};

initSmoother();

</script>